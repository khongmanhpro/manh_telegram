# ================================================
# Telegram Shop Bot - Cấu hình môi trường
# ================================================
# Copy file này thành .env và điền thông tin:
#   cp .env.example .env
# ================================================

# Telegram Bot Token (lấy từ @BotFather trên Telegram)
BOT_TOKEN=your_bot_token_here

# Admin Telegram ID — nhiều admin cách nhau bằng dấu phẩy (gửi /myid cho bot để lấy ID)
ADMIN_IDS=your_telegram_id_here

# ================================================
# Ngân hàng 1 (bắt buộc) - Thanh toán QR VietQR
# ================================================
# Tra mã BIN tại: https://www.vietqr.io/danh-sach-ngan-hang
# Có thể đổi khi bot đang chạy bằng lệnh /setbank
BANK_BIN=970422
BANK_ACCOUNT=your_bank_account_number
BANK_ACCOUNT_NAME=YOUR_FULL_NAME
BANK_NAME=MB

# ================================================
# Ngân hàng 2 (tùy chọn - cho khách chọn bank)
# ================================================
# BANK2_BIN=970436
# BANK2_ACCOUNT=your_second_bank_account
# BANK2_ACCOUNT_NAME=YOUR_FULL_NAME
# BANK2_NAME=VCB

# ================================================
# Thanh toán tự động qua SePay (khuyến nghị)
# ================================================
# 1. Đăng ký https://sepay.vn, liên kết tài khoản ngân hàng
# 2. Tạo Webhook: URL = https://<domain>/webhook/sepay
#    Kiểu chứng thực: API Key → điền SEPAY_API_KEY bên dưới
# Để trống = admin xác nhận thanh toán thủ công
# SEPAY_API_KEY=your_sepay_api_key
WEBHOOK_PORT=3000

# ================================================
# Telegram webhook (tùy chọn, để trống = long polling)
# ================================================
# Domain HTTPS trỏ về WEBHOOK_PORT (qua Nginx/Caddy/Cloudflare Tunnel)
# TELEGRAM_WEBHOOK_DOMAIN=bot.example.com
# TELEGRAM_WEBHOOK_SECRET=random_secret_string

# ================================================
# Admin web (tùy chọn)
# ================================================
# Giao diện quản trị: http://localhost:3000/admin
# Dùng mật khẩu dài, ngẫu nhiên; không commit file .env thật.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change_this_password
# WEB_SESSION_SECRET=change_this_to_a_long_random_secret
# WEB_SESSION_TTL=28800

# ================================================
# Thông tin Shop (đổi được bằng /setshop)
# ================================================
SHOP_NAME=My Shop
SUPPORT_CONTACT=@your_telegram_username
# Zalo hỗ trợ (số điện thoại hoặc link zalo.me) và slogan hiển thị ở lời chào — đổi bằng /setshop
# SUPPORT_ZALO=0987654321
# SHOP_TAGLINE=Uy tín tạo nên thương hiệu
# Hướng dẫn mặc định gửi kèm tài khoản (đổi theo sản phẩm bằng /setnote)
# DEFAULT_DELIVERY_NOTE="email | pass mail | pass\nĐăng nhập outlook.com để lấy code"

# ================================================
# Đơn hàng & nạp tiền
# ================================================
ORDER_EXPIRE_MINUTES=15
MAX_PENDING_ORDERS=3
MAX_QTY=50
LOW_STOCK_THRESHOLD=3
NAP_MIN=10000
NAP_MAX=50000000

# ================================================
# Báo cáo & backup tự động (HH:MM, để trống để tắt)
# ================================================
TZ=Asia/Ho_Chi_Minh
DAILY_REPORT_TIME=22:00
BACKUP_TIME=03:00
BACKUP_KEEP=7

# ================================================
# Google Sheet Sync (tùy chọn)
# ================================================
# 1. Mở Google Sheet → Chia sẻ → "Bất kỳ ai có đường liên kết đều xem được"
# 2. Copy Sheet ID từ URL: docs.google.com/spreadsheets/d/[SHEET_ID]/edit
# Cột: A=ID, B=Sản phẩm, C=Giá, D=Đơn vị, E=Số lượng, F=Còn hàng, G=Link liên hệ, H=Ghi chú, I=Danh mục
# GOOGLE_SHEET_ID=your_google_sheet_id
# SHEET_SYNC_INTERVAL=5
